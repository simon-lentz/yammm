schema "graph_corpus"

type Order {
    order_id String primary
    customer String required

    *-> SECTIONS (_:many) Section
    *-> INVOICE (one) Invoice
    *-> STAMP (one) Stamp
}

part type Section {
    section_id String primary
    heading    String required

    *-> NOTES (_:many) Note
}

part type Note {
    note_id String primary
    body    String required
}

part type Invoice {
    invoice_id String primary
    amount     String required
}

part type Stamp {
    mark String required
}
