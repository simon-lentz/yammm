schema "g4"

// G4: a long invariant carrying a "&&" inside its trailing comment. The
// wrapper looks for a top-level logical operator by scanning text, finds the
// one in the comment, and breaks the line there.
type T {
	id    String primary
	left  Integer
	right Integer

	! "left and right must both be positive and bounded" $self.left > 0 && $self.right > 0 && $self.left < 1000 // and && more
}
