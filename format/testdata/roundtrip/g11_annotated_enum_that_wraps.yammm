schema "g11"

// G11: a long annotated enum property. Wrapping moves the annotation onto the
// closing "]" line, where it attaches to nothing: the output parses and is
// then refused at load with E_INVALID_ANNOTATION.
type T {
	id    String primary
	state Enum["pending_review", "approved", "rejected", "needs_revision", "escalated", "archived"] @index
}
