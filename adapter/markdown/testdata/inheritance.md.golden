classDiagram
    direction TB
    class Region {
        id String
    }
    class GeoEntity {
        <<Abstract>>
        id UUID
        name String
    }
    class County {
        fips String
    }
    class City {
        population Integer
    }
    GeoEntity --> Region : IN_REGION (one)
    GeoEntity <|-- County
    GeoEntity <|-- City
```

