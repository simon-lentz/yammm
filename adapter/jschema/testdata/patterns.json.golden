{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contacts",
  "description": "Instance-data authoring schema generated by yammm. Describes the JSON object form yammm reads: one key per type whose instances a data file lists at the top level, each an array of instances. It does not reproduce yammm's validation: `yammm check` gives the verdict on a file.",
  "type": "object",
  "properties": {
    "Contact": { "type": "array", "items": { "$ref": "#/$defs/Contact" } }
  },
  "additionalProperties": false,
  "$defs": {
    "Contact": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": {
          "type": "string",
          "pattern": "^[%+\\-.0-9A-Z_a-z]+@[\\-.0-9A-Za-z]+\\.[A-Za-z]{2,}$"
        },
        "phone": {
          "type": "string",
          "allOf": [
            { "pattern": "^[0-9]{3}-[0-9]{3}-[0-9]{4}$" },
            { "pattern": "^[\\-0-9]{12}$" }
          ]
        }
      },
      "required": ["id", "email"],
      "additionalProperties": false
    }
  }
}
