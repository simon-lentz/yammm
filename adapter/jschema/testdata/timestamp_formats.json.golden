{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fleet",
  "description": "Instance-data authoring schema generated by yammm. Describes the JSON object form accepted by `yammm check`: one key per concrete type, each an array of instances.",
  "type": "object",
  "properties": {
    "Reading": { "type": "array", "items": { "$ref": "#/$defs/Reading" } }
  },
  "additionalProperties": false,
  "$defs": {
    "Reading": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taken_at": { "type": "string", "format": "date-time" },
        "logged_at": {
          "type": "string",
          "description": "Timestamp[\"2006-01-02 15:04:05\"]"
        }
      },
      "required": ["id", "taken_at"],
      "additionalProperties": false
    }
  }
}
