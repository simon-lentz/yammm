{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "geo",
  "description": "Instance-data authoring schema generated by yammm. Describes the JSON object form yammm reads: one key per type whose instances a data file lists at the top level, each an array of instances. It does not reproduce yammm's validation: `yammm check` gives the verdict on a file.",
  "type": "object",
  "properties": {
    "County": { "type": "array", "items": { "$ref": "#/$defs/County" } }
  },
  "additionalProperties": false,
  "$defs": {
    "County": {
      "type": "object",
      "properties": {
        "fips": { "type": "string", "minLength": 5, "maxLength": 5 },
        "name": { "type": "string", "minLength": 1 },
        "population": { "type": "integer", "minimum": 0 },
        "density": { "type": "number", "minimum": 0, "maximum": 100000 },
        "rank": { "type": "integer", "maximum": 99 },
        "active": { "type": "boolean" },
        "founded": { "type": "string", "format": "date" },
        "updated_at": { "type": "string", "format": "date-time" },
        "guid": { "type": "string", "format": "uuid" },
        "embedding": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "maxItems": 5
        }
      },
      "required": ["fips", "name", "population", "active"],
      "additionalProperties": false
    }
  }
}
