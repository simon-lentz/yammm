{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "geo",
  "description": "Instance-data authoring schema generated by yammm. Describes the JSON object form accepted by `yammm check`: one key per concrete type, each an array of instances.",
  "type": "object",
  "properties": {
    "State": { "type": "array", "items": { "$ref": "#/$defs/State" } },
    "County": { "type": "array", "items": { "$ref": "#/$defs/County" } }
  },
  "additionalProperties": false,
  "$defs": {
    "State": {
      "type": "object",
      "description": "State is a US state.",
      "properties": { "code": { "type": "string" } },
      "required": ["code"],
      "additionalProperties": false
    },
    "District": {
      "type": "object",
      "properties": { "id": { "type": "string", "format": "uuid" } },
      "required": ["id"],
      "additionalProperties": false
    },
    "County": {
      "type": "object",
      "description": "County is a US county node.",
      "properties": {
        "fips": { "$ref": "#/$defs/FipsCode" },
        "population": {
          "type": "integer",
          "description": "population is the resident count at the last census."
        },
        "has_district": {
          "type": "array",
          "items": { "$ref": "#/$defs/District" },
          "description": "Composition HAS_DISTRICT (many) → District. HAS_DISTRICT holds electoral districts."
        },
        "in_state": {
          "$ref": "#/$defs/EDGE_County_in_state_State",
          "description": "Association IN_STATE (one) → State. Presence is enforced when the graph is assembled, not per-file. IN_STATE records the county's state."
        }
      },
      "required": ["fips", "population"],
      "additionalProperties": false
    },
    "EDGE_County_in_state_State": {
      "type": "object",
      "properties": { "_target_code": { "type": "string" } },
      "required": ["_target_code"],
      "additionalProperties": false
    },
    "FipsCode": {
      "type": "string",
      "minLength": 5,
      "maxLength": 5,
      "description": "FipsCode is a five-character FIPS identifier."
    }
  }
}
