{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "geo",
  "description": "Instance-data authoring schema generated by yammm. Describes the JSON object form accepted by `yammm check`: one key per concrete type, each an array of instances.",
  "type": "object",
  "properties": {
    "County": { "type": "array", "items": { "$ref": "#/$defs/County" } },
    "common.Region": { "type": "array", "items": { "$ref": "#/$defs/Region" } }
  },
  "additionalProperties": false,
  "$defs": {
    "County": {
      "type": "object",
      "properties": {
        "fips": { "type": "string" },
        "in_region": {
          "$ref": "#/$defs/EDGE_County_in_region_Region",
          "description": "Association IN_REGION (one) → Region. Presence is enforced when the graph is assembled, not per-file."
        }
      },
      "required": ["fips"],
      "additionalProperties": false
    },
    "Region": {
      "type": "object",
      "properties": {
        "code": { "$ref": "#/$defs/RegionCode" },
        "name": { "type": "string" },
        "in_basin": {
          "$ref": "#/$defs/EDGE_Region_in_basin_Basin",
          "description": "Association IN_BASIN (_) → Basin."
        }
      },
      "required": ["code", "name"],
      "additionalProperties": false
    },
    "Basin": {
      "type": "object",
      "properties": { "id": { "type": "string" } },
      "required": ["id"],
      "additionalProperties": false
    },
    "EDGE_County_in_region_Region": {
      "type": "object",
      "properties": { "_target_code": { "$ref": "#/$defs/RegionCode" } },
      "required": ["_target_code"],
      "additionalProperties": false
    },
    "EDGE_Region_in_basin_Basin": {
      "type": "object",
      "properties": { "_target_id": { "type": "string" } },
      "required": ["_target_id"],
      "additionalProperties": false
    },
    "RegionCode": { "type": "string", "minLength": 5, "maxLength": 5 }
  }
}
