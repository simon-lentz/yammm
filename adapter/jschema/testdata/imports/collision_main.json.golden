{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "geo",
  "description": "Instance-data authoring schema generated by yammm. Describes the JSON object form accepted by `yammm check`: one key per concrete type, each an array of instances.",
  "type": "object",
  "properties": {
    "Region": {
      "type": "array",
      "items": { "$ref": "#/$defs/geo.Region" }
    },
    "County": { "type": "array", "items": { "$ref": "#/$defs/County" } },
    "common.Region": {
      "type": "array",
      "items": { "$ref": "#/$defs/common.Region" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "geo.Region": {
      "type": "object",
      "properties": { "id": { "type": "string" } },
      "required": ["id"],
      "additionalProperties": false
    },
    "County": {
      "type": "object",
      "properties": {
        "fips": { "type": "string" },
        "in_region": {
          "$ref": "#/$defs/EDGE_County_in_region_common.Region",
          "description": "Association IN_REGION (one) → common.Region. Presence is enforced when the graph is assembled, not per-file."
        }
      },
      "required": ["fips"],
      "additionalProperties": false
    },
    "common.Region": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["code", "name"],
      "additionalProperties": false
    },
    "EDGE_County_in_region_common.Region": {
      "type": "object",
      "properties": { "_target_code": { "type": "string" } },
      "required": ["_target_code"],
      "additionalProperties": false
    }
  }
}
