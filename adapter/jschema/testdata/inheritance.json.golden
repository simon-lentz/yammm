{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "geo",
  "description": "Instance-data authoring schema generated by yammm. Describes the JSON object form accepted by `yammm check`: one key per concrete type, each an array of instances.",
  "type": "object",
  "properties": {
    "Region": { "type": "array", "items": { "$ref": "#/$defs/Region" } },
    "County": { "type": "array", "items": { "$ref": "#/$defs/County" } },
    "City": { "type": "array", "items": { "$ref": "#/$defs/City" } }
  },
  "additionalProperties": false,
  "$defs": {
    "Region": {
      "type": "object",
      "properties": { "id": { "type": "string" } },
      "required": ["id"],
      "additionalProperties": false
    },
    "County": {
      "type": "object",
      "properties": {
        "fips": { "type": "string" },
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "in_region": {
          "$ref": "#/$defs/EDGE_GeoEntity_in_region_Region",
          "description": "Association IN_REGION (one) → Region. Presence is enforced when the graph is assembled, not per-file."
        }
      },
      "required": ["fips", "id", "name"],
      "additionalProperties": false
    },
    "City": {
      "type": "object",
      "properties": {
        "population": { "type": "integer" },
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "in_region": {
          "$ref": "#/$defs/EDGE_GeoEntity_in_region_Region",
          "description": "Association IN_REGION (one) → Region. Presence is enforced when the graph is assembled, not per-file."
        }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "EDGE_GeoEntity_in_region_Region": {
      "type": "object",
      "properties": { "_target_id": { "type": "string" } },
      "required": ["_target_id"],
      "additionalProperties": false
    }
  }
}
