{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fleet",
  "description": "Instance-data authoring schema generated by yammm. Describes the JSON object form accepted by `yammm check`: one key per concrete type, each an array of instances.",
  "type": "object",
  "properties": {
    "Person": { "type": "array", "items": { "$ref": "#/$defs/Person" } },
    "Car": { "type": "array", "items": { "$ref": "#/$defs/Car" } }
  },
  "additionalProperties": false,
  "$defs": {
    "Person": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "age": { "type": "integer", "minimum": 0, "maximum": 150 }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "Car": {
      "type": "object",
      "properties": {
        "vin": { "type": "string" },
        "color": { "type": "string", "enum": ["red", "green"] },
        "wheels": {
          "type": "array",
          "items": { "$ref": "#/$defs/Wheel" },
          "minItems": 1,
          "description": "Composition WHEELS (one:many) → Wheel."
        },
        "owner": {
          "$ref": "#/$defs/EDGE_Car_owner_Person",
          "description": "Association OWNER (one) → Person. Presence is enforced when the graph is assembled, not per-file."
        }
      },
      "required": ["vin", "wheels"],
      "additionalProperties": false
    },
    "Wheel": {
      "type": "object",
      "properties": {
        "position": { "type": "string", "enum": ["FL", "FR", "RL", "RR"] }
      },
      "required": ["position"],
      "additionalProperties": false
    },
    "EDGE_Car_owner_Person": {
      "type": "object",
      "properties": { "_target_id": { "type": "string", "format": "uuid" } },
      "required": ["_target_id"],
      "additionalProperties": false
    }
  }
}
