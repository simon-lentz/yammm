{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "geo",
  "description": "Instance-data authoring schema generated by yammm. Describes the JSON object form accepted by `yammm check`: one key per concrete type, each an array of instances.",
  "type": "object",
  "properties": {
    "State": { "type": "array", "items": { "$ref": "#/$defs/State" } },
    "County": { "type": "array", "items": { "$ref": "#/$defs/County" } }
  },
  "additionalProperties": false,
  "$defs": {
    "State": {
      "type": "object",
      "properties": {
        "code": { "$ref": "#/$defs/StateCode" },
        "name": { "type": "string" }
      },
      "required": ["code", "name"],
      "additionalProperties": false
    },
    "County": {
      "type": "object",
      "properties": {
        "fips": { "type": "string" },
        "in_state": {
          "$ref": "#/$defs/EDGE_County_in_state_State",
          "description": "Association IN_STATE (one) → State. Presence is enforced when the graph is assembled, not per-file."
        }
      },
      "required": ["fips"],
      "additionalProperties": false
    },
    "EDGE_County_in_state_State": {
      "type": "object",
      "properties": {
        "_target_code": { "$ref": "#/$defs/StateCode" },
        "since": { "type": "integer" },
        "notes": { "type": "string" },
        "code_tag": { "$ref": "#/$defs/StateCode" }
      },
      "required": ["_target_code", "since"],
      "additionalProperties": false
    },
    "StateCode": { "type": "string", "minLength": 2, "maxLength": 2 }
  }
}
