{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "composite",
  "description": "Instance-data authoring schema generated by yammm. Describes the JSON object form accepted by `yammm check`: one key per concrete type, each an array of instances.",
  "type": "object",
  "properties": {
    "Region": { "type": "array", "items": { "$ref": "#/$defs/Region" } },
    "Sensor": { "type": "array", "items": { "$ref": "#/$defs/Sensor" } }
  },
  "additionalProperties": false,
  "$defs": {
    "Region": {
      "type": "object",
      "properties": {
        "country": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["country", "code", "name"],
      "additionalProperties": false
    },
    "Sensor": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "located_in": {
          "$ref": "#/$defs/EDGE_Sensor_located_in_Region",
          "description": "Association LOCATED_IN (one) → Region. Presence is enforced when the graph is assembled, not per-file."
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "EDGE_Sensor_located_in_Region": {
      "type": "object",
      "properties": {
        "_target_country": { "type": "string" },
        "_target_code": { "type": "string" }
      },
      "required": ["_target_country", "_target_code"],
      "additionalProperties": false
    }
  }
}
