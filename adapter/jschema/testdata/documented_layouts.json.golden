{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fleet_docs",
  "description": "Instance-data authoring schema generated by yammm. Describes the JSON object form accepted by `yammm check`: one key per concrete type, each an array of instances.",
  "type": "object",
  "properties": {
    "Station": { "type": "array", "items": { "$ref": "#/$defs/Station" } },
    "Reading": { "type": "array", "items": { "$ref": "#/$defs/Reading" } }
  },
  "additionalProperties": false,
  "$defs": {
    "Station": {
      "type": "object",
      "properties": { "id": { "type": "string" } },
      "required": ["id"],
      "additionalProperties": false
    },
    "Reading": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "logged_at": {
          "type": "string",
          "description": "Timestamp[\"2006-01-02 15:04:05\"] logged_at is when the operator filed the reading."
        },
        "filed_as": {
          "$ref": "#/$defs/Stamp",
          "description": "filed_as carries the documented DataType alias."
        },
        "undocumented": {
          "type": "string",
          "description": "Timestamp[\"2006-01-02 15:04:05\"]"
        },
        "at_station": {
          "$ref": "#/$defs/EDGE_Reading_at_station_Station",
          "description": "Association AT_STATION (_) → Station."
        }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "EDGE_Reading_at_station_Station": {
      "type": "object",
      "properties": {
        "_target_id": { "type": "string" },
        "observed_at": {
          "type": "string",
          "description": "Timestamp[\"2006-01-02 15:04:05\"] observed_at is when the sensor sampled."
        }
      },
      "required": ["_target_id"],
      "additionalProperties": false
    },
    "Stamp": {
      "type": "string",
      "description": "Timestamp[\"2006-01-02 15:04:05\"] Stamp is a wall-clock reading with no zone."
    }
  }
}
