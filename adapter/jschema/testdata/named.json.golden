{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "geo",
  "description": "Instance-data authoring schema generated by yammm. Describes the JSON object form accepted by `yammm check`: one key per concrete type, each an array of instances.",
  "type": "object",
  "properties": {
    "County": { "type": "array", "items": { "$ref": "#/$defs/County" } }
  },
  "additionalProperties": false,
  "$defs": {
    "County": {
      "type": "object",
      "properties": {
        "fips": { "$ref": "#/$defs/FipsCode" },
        "tier": { "$ref": "#/$defs/Tier" },
        "status": {
          "type": "string",
          "enum": ["active", "merged", "dissolved"]
        },
        "codes": { "type": "array", "items": { "$ref": "#/$defs/FipsCode" } }
      },
      "required": ["fips", "tier", "status"],
      "additionalProperties": false
    },
    "FipsCode": { "type": "string", "minLength": 5, "maxLength": 5 },
    "Tier": { "type": "string", "enum": ["gold", "silver"] }
  }
}
