{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fleet",
  "description": "Instance-data authoring schema generated by yammm. Describes the JSON object form yammm reads: one key per type whose instances a data file lists at the top level, each an array of instances. It does not reproduce yammm's validation: `yammm check` gives the verdict on a file.",
  "type": "object",
  "properties": {
    "Car": { "type": "array", "items": { "$ref": "#/$defs/Car" } }
  },
  "additionalProperties": false,
  "$defs": {
    "Car": {
      "type": "object",
      "properties": {
        "vin": { "type": "string" },
        "color": { "type": "string", "enum": ["red", "green", "blue"] },
        "sizes": {
          "type": "array",
          "items": { "type": "string", "enum": ["s", "m", "l"] }
        }
      },
      "required": ["vin"],
      "additionalProperties": false
    }
  }
}
