{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fleet",
  "description": "Instance-data authoring schema generated by yammm. Describes the JSON object form accepted by `yammm check`: one key per concrete type, each an array of instances.",
  "type": "object",
  "properties": {
    "Car": { "type": "array", "items": { "$ref": "#/$defs/Car" } }
  },
  "additionalProperties": false,
  "$defs": {
    "Car": {
      "type": "object",
      "properties": {
        "vin": { "type": "string" },
        "color": { "type": "string", "enum": ["red", "green", "blue"] },
        "sizes": {
          "type": "array",
          "items": { "type": "string", "enum": ["s", "m", "l"] }
        }
      },
      "required": ["vin"],
      "additionalProperties": false
    }
  }
}
