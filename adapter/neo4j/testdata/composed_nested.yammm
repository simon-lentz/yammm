schema "nested_test"

type Order {
    order_id String primary
    customer String required

    *-> SECTIONS (_:many) Section
}

part type Section {
    section_id String primary
    heading    String required

    *-> NOTES (_:many) Note
}

part type Note {
    body String required
}

// A Timestamp-keyed root composing a (_:many) part, which composes a (one)
// part, which composes keyless (_:many) parts: the depth-two and depth-three
// composed-key shapes, under a root key that canonicalizes.
type Run {
    at Timestamp primary

    *-> STEPS (_:many) Step
}

part type Step {
    step_id String primary

    *-> SUMMARY (one) StepSummary
}

part type StepSummary {
    label String required

    *-> MARKS (_:many) Mark
}

part type Mark {
    mark String required
}
