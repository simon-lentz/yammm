# `gen --to cypher` and `neo4j diff` compose labels and emit constraints from ONE
# flag set, because `diff` computes its desired side exactly as gen emits it. A
# flag one command has and the other lacks is a plan reporting drift the
# operator never introduced.

# --prefix applies to constraints AND indexes, so a graph generated with a
# prefix can be regenerated and diffed against.
exec yammm gen --to cypher --prefix app_ valid.yammm
stdout 'FOR \(n:app_test__Person\) REQUIRE'
stdout 'CREATE INDEX app_test__Person_name_idx IF NOT EXISTS FOR \(n:app_test__Person\)'

# --separator likewise, on both.
exec yammm gen --to cypher --separator _ valid.yammm
stdout 'FOR \(n:test_Person\) REQUIRE'
stdout 'test_Person_name_idx'

# A separator the schema name holds composes a label that reads two ways, and
# the schema is refused.
! exec yammm gen --to cypher --separator t valid.yammm
stderr 'E_NEO4J_INVALID_IDENTIFIER'
stderr 'schema "test" composes no node label'
! stdout .

# The constraint-shape flags reach gen, so a graph generated with NODE KEY can
# be reproduced.
exec yammm gen --to cypher --node-keys valid.yammm
stdout 'IS NODE KEY'
! stdout 'IS UNIQUE'

# `diff` accepts every one of them, so its desired side can be configured to
# match. It fails on connection, not on flag parsing.
! exec yammm neo4j diff --uri neo4j://127.0.0.1:1 --prefix app_ --node-keys --type-constraints none --separator _ valid.yammm
! stderr 'unknown flag'

-- valid.yammm --
schema "test"

type Person {
	id   String  primary
	name String  required @index
	age  Integer
}
