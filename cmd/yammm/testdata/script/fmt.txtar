# fmt: canonical formatting to stdout by default, in place with --write, and
# a list of the files that differ with -l.

# Formatting to stdout matches the canonical form exactly.
exec yammm fmt unformatted.yammm
cmp stdout formatted_golden.yammm

# --write rewrites the file in place.
cp unformatted.yammm work.yammm
exec yammm fmt --write work.yammm
cmp work.yammm formatted_golden.yammm

# Formatting is idempotent: a second --write changes nothing.
exec yammm fmt --write work.yammm
cmp work.yammm formatted_golden.yammm

# Missing input is an error.
! exec yammm fmt nonexistent.yammm

# -l is silent and succeeds on a canonical file.
exec yammm fmt -l formatted_golden.yammm
! stdout .

# -l names the unformatted file and succeeds, as gofmt -l does: the path on
# stdout and nothing on stderr.
exec yammm fmt -l unformatted.yammm
stdout '^unformatted\.yammm$'
! stderr .

# One run over a list names every offender and no formatted file.
cp unformatted.yammm other.yammm
exec yammm fmt -l unformatted.yammm formatted_golden.yammm other.yammm
stdout '^unformatted\.yammm$'
stdout '^other\.yammm$'
! stdout 'formatted_golden'
! stderr .

# -l with -w names each file it rewrites.
cp unformatted.yammm both.yammm
exec yammm fmt -l -w both.yammm
stdout '^both\.yammm$'
cmp both.yammm formatted_golden.yammm

# A parse failure is reported per file, on stderr, which the in-process cobra
# buffers cannot see, and exits 1.
! exec yammm fmt -l broken.yammm
stderr '^broken\.yammm:4:1: error\[E_SYNTAX\]'

# A canonical file that starts with a UTF-8 byte order mark is unformatted:
# -l names it, and -w removes the mark and nothing else.
exec yammm fmt -l marked.yammm
stdout '^marked\.yammm$'
! stderr .
exec yammm fmt --write marked.yammm
cmp marked.yammm formatted_golden.yammm

-- marked.yammm --
﻿schema "test"

type Person {
	id   String primary
	name String required
	age  Integer
}
-- broken.yammm --
schema "test"
type Person {

-- unformatted.yammm --
schema "test"
type   Person   {
id   String   primary
  name    String    required
    age     Integer
}
-- formatted_golden.yammm --
schema "test"

type Person {
	id   String primary
	name String required
	age  Integer
}
