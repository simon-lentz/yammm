# gen --to go: generated Go source to stdout or --output, with --package and
# --initialisms overrides.

exec yammm gen --to go county.yammm
stdout '// Code generated by yammm\. DO NOT EDIT\.'
stdout 'type County struct'

# --output writes the file and keeps stdout free of code.
exec yammm gen --to go --output county_gen.go county.yammm
exists county_gen.go
grep 'type County struct' county_gen.go
! stdout 'type County struct'

# --package overrides the schema-derived package clause.
exec yammm gen --to go --package custompkg county.yammm
stdout 'package custompkg'

# --initialisms injects consumer vocabulary: jwt_token becomes JWTToken.
exec yammm gen --to go --initialisms JWT session.yammm
stdout 'JWTToken'

# --module-root resolves module-style imports against a root other than the
# schema's own directory, and embedded source keys are root-relative.
exec yammm gen --to go --module-root registry registry/a/b/entry.yammm
stdout 'type Contract struct'
stdout 'type Vendor struct'
stdout '"a/b/entry.yammm":'
stdout '"lib/dep.yammm":'

# Without --module-root the module-style import cannot resolve (the default
# root is the schema's own directory).
! exec yammm gen --to go registry/a/b/entry.yammm
stderr 'lib/dep'

# gen --to md: a self-contained Markdown reference document with a Mermaid
# class diagram and per-type sections.
exec yammm gen --to md county.yammm
stdout '# Schema geo'
stdout '```mermaid'
stdout '### County'

# --no-class-diagram omits the diagram section and its fence.
exec yammm gen --to md --no-class-diagram county.yammm
! stdout 'mermaid'
stdout '### County'

# --no-class-members keeps the diagram and drops the member lines.
exec yammm gen --to md --no-class-members county.yammm
stdout 'mermaid'
stdout 'class County'
! stdout 'fips String'
stdout '### County'

# "markdown" is accepted as an alias for md.
exec yammm gen --to markdown county.yammm
stdout '# Schema geo'

# --output writes the document to a file and keeps stdout free of it.
exec yammm gen --to md --output county.md county.yammm
exists county.md
grep '## Class Diagram' county.md
! stdout '## Class Diagram'

# The md target flattens the import closure like the other targets; imported
# schemas get their own section with schema-qualified type headings.
exec yammm gen --to md --module-root registry registry/a/b/entry.yammm
stdout '## Schema deplib \(imported as dep\)'
stdout '### dep\.Vendor'

# Per-target flag rejection covers the md target in both directions.
! exec yammm gen --to md --package foo county.yammm
stderr 'flag --package applies only to --to go'
! exec yammm gen --to go --no-class-diagram county.yammm
stderr 'flag --no-class-diagram applies only to --to md'
! exec yammm gen --to go --no-class-members county.yammm
stderr 'flag --no-class-members applies only to --to md'

-- county.yammm --
schema "geo"

type County {
	fips String primary
	name String required
}
-- session.yammm --
schema "auth"

type Session {
	id UUID primary
	jwt_token String required
}
-- registry/a/b/entry.yammm --
schema "registry"

import "lib/dep" as dep

type Contract {
	contract_id String primary
	--> SUPPLIED_BY (one) dep.Vendor
}
-- registry/lib/dep.yammm --
schema "deplib"

type Vendor {
	vendor_id String primary
	name String required
}
