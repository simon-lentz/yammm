# check: validates data files against a schema. JSON auto-detects; CSV needs
# an explicit --type; failures render diagnostics.

exec yammm check valid.yammm data.json

exec yammm check --type Person valid.yammm data.csv

# CSV without --type is rejected.
! exec yammm check valid.yammm data.csv

# Missing data file is rejected.
! exec yammm check valid.yammm nonexistent.json

# Invalid data fails and the JSON diagnostics format emits structured fields
# on stderr.
! exec yammm check --format json valid.yammm bad.json
stderr '"severity"'
stderr '"error"'

# --module-root reaches every schema-loading command, not only gen.
! exec yammm check sub/entry.yammm empty.json
stderr 'E_IMPORT_RESOLVE'
exec yammm check --module-root . sub/entry.yammm empty.json

-- sub/entry.yammm --
schema "entry"

import "lib/dep" as dep

type Thing {
	id String primary
	--> USES (one) dep.Part
}
-- lib/dep.yammm --
schema "dep"

type Part {
	part_id String primary
}
-- empty.json --
{"Thing": []}
-- valid.yammm --
schema "test"

type Person {
	id   String primary
	name String required
	age  Integer
}
-- data.json --
{
  "Person": [
    {"id": "alice", "name": "Alice", "age": 30},
    {"id": "bob", "name": "Bob", "age": 25}
  ]
}
-- data.csv --
id,name,age
carol,Carol,28
dave,Dave,35
-- bad.json --
{"Person": [{"id": "x"}]}
