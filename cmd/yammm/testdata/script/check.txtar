# check: validates data files against a schema. JSON auto-detects; CSV needs
# an explicit --type; failures render diagnostics.

exec yammm check valid.yammm data.json

# A data file that starts with a UTF-8 byte order mark parses as the same
# document, as a CSV file already did.
exec yammm check valid.yammm marked.json
! stderr .

exec yammm check --type Person valid.yammm data.csv

# CSV without --type is rejected.
! exec yammm check valid.yammm data.csv

# An unknown --from is a usage error, exit 2.
! exec yammm check --from xml valid.yammm data.json
stderr 'unsupported format "xml"'

# Missing data file is rejected.
! exec yammm check valid.yammm nonexistent.json

# Invalid data fails and the JSON diagnostics format emits structured fields
# on stderr.
! exec yammm check --format json valid.yammm bad.json
stderr '"severity"'
stderr '"error"'

# check assembles the graph as load does, so a duplicate primary key and an
# unresolved required association fail it too.
! exec yammm check linked.yammm dup.json
stderr 'E_DUPLICATE_PK'
! exec yammm check linked.yammm unresolved.json
stderr 'E_UNRESOLVED_REQUIRED'
! exec yammm check linked.yammm absent.json
stderr 'E_UNRESOLVED_REQUIRED'
exec yammm check linked.yammm linked.json
! stderr .

# --module-root reaches every schema-loading command, not only gen.
! exec yammm check sub/entry.yammm empty.json
stderr 'E_IMPORT_RESOLVE'
exec yammm check --module-root . sub/entry.yammm empty.json

-- sub/entry.yammm --
schema "entry"

import "lib/dep" as dep

type Thing {
	id String primary
	--> USES (one) dep.Part
}
-- lib/dep.yammm --
schema "dep"

type Part {
	part_id String primary
}
-- empty.json --
{"Thing": []}
-- valid.yammm --
schema "test"

type Person {
	id   String primary
	name String required
	age  Integer
}
-- marked.json --
﻿{
  "Person": [
    {"id": "alice", "name": "Alice", "age": 30},
    {"id": "bob", "name": "Bob", "age": 25}
  ]
}
-- data.json --
{
  "Person": [
    {"id": "alice", "name": "Alice", "age": 30},
    {"id": "bob", "name": "Bob", "age": 25}
  ]
}
-- data.csv --
id,name,age
carol,Carol,28
dave,Dave,35
-- bad.json --
{"Person": [{"id": "x"}]}
-- linked.yammm --
schema "linked"

type Person {
	id   String primary
	name String required
	--> MANAGER (one) Person
}
-- linked.json --
{"Person": [{"id": "a", "name": "A", "manager": {"_target_id": "a"}}]}
-- dup.json --
{"Person": [
  {"id": "a", "name": "A", "manager": {"_target_id": "a"}},
  {"id": "a", "name": "B", "manager": {"_target_id": "a"}}
]}
-- unresolved.json --
{"Person": [{"id": "a", "name": "A", "manager": {"_target_id": "zz"}}]}
-- absent.json --
{"Person": [{"id": "a", "name": "A"}]}
