# export: graph data out to json or cypher — from raw data files or
# from a .ys snapshot (auto-detected).

exec yammm export --to json valid.yammm data.json
stdout '"Person"'
stdout '"alice"'

exec yammm export --to cypher valid.yammm data.json
stdout 'MERGE'

# --output writes the export to a file.
exec yammm export --to json --output out.json valid.yammm data.json
grep '"Person"' out.json

# --output /dev/stdout writes through the descriptor: here stdout is a pipe, and
# no rename can stand in for one. Windows has no /dev/stdout.
[!windows] exec yammm export --to json --output /dev/stdout valid.yammm data.json
[!windows] stdout '"alice"'

# csv is no target.
! exec yammm export --to csv valid.yammm data.json
stderr 'must be json or cypher'

# --to is required.
! exec yammm export valid.yammm data.json

# A .ys snapshot input is auto-detected and exports identically.
exec yammm snapshot save valid.yammm data.json -o snap.ys
exec yammm export --to json valid.yammm snap.ys
stdout '"Person"'
stdout '"alice"'
exec yammm export --to cypher valid.yammm snap.ys
stdout 'MERGE'

-- valid.yammm --
schema "test"

type Person {
	id   String primary
	name String required
	age  Integer
}
-- data.json --
{
  "Person": [
    {"id": "alice", "name": "Alice", "age": 30},
    {"id": "bob", "name": "Bob", "age": 25}
  ]
}
