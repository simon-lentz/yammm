// Comprehensive formatting test fixture.
// Exercises all formatting rules in a single file.
schema "comprehensive"


import "./geo" as geo
import "./catalog" as catalog


type RegionCode = String[2, 2]
type DistrictCode = String[3,3]
type RegionID = String[1, 15]
type LongStatus = Enum["active", "inactive", "pending", "suspended", "terminated", "archived", "deleted", "expired", "revoked"]

/*
 * Abstract base type for auditable entities.
 */
abstract type   Auditable{
    created_at Timestamp  required
    updated_at Timestamp
    created_by String
    run_id String required
}

part type   LineItem{
    quantity Integer[1, _] required
    price Float[0.0,_] required
    note String // optional note

    ! "positive_qty" quantity > 0
    ! "positive_price" price >= 0.0
}


type Region   extends Auditable {
    region_id String primary
    name String  required
    name_norm String required
    region_code RegionCode required // area code
    land_area Float // sq meters
    water_area Float

    ! "name_norm_not_empty" name_norm != ""
    ! "name_not_blank" name -> Len > 0
}


type   District extends Auditable{
    region_id String primary
    name String required
    name_norm String required
    region_code RegionCode required
    district_code DistrictCode required // district code
    grade Enum["A", "B", "C", "D", "E", "F"] required

    --> IN_REGION (one) Region
    --> ADJACENT_TO (_:many) District // adjacency
    *-> HAS_DETAIL (many) LineItem

    ! "name_norm_not_empty" name_norm != ""
    ! "has_region" region_code != ""
    ! "valid_grade" grade == "A" || grade == "F"
}


type Publisher extends Auditable {
    publisher_id String primary
    name String required
    name_norm String required
    region_code String[2, 2] required
    is_active Boolean required
    deactivated_at Timestamp
    deactivated_reason Enum["removed", "replaced", "merged", "manual"]
    source_fetched_at Timestamp  required

    --> LOCATED_IN (_:one) geo.Region
    --> PUBLISHES (many) catalog.Book

    ! "name_not_empty" name_norm != ""
    ! "active_or_reason" is_active || deactivated_reason != nil
}
