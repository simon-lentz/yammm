schema "alignment"

type RegionCode = String[2, 2]
type DistrictCode = String[3, 3]
type RegionID = String[1, 15]

type Region {
    region_id String primary
    name String required
    region_code RegionCode required // area code
    land_area Float // sq meters
    water_area Float
}

type District {
    region_id String primary
    name String required
    region_code RegionCode required
    district_code DistrictCode required // district code
    grade Enum["A", "B", "C", "D", "E", "F"] required

    --> IN_REGION (one) Region
    *-> HAS_SUBDISTRICT (many) Subdistrict
    --> ADJACENT_TO (_:many) District // adjacency
}

part type Subdistrict {
    region_id String primary
    name String required
    grade String
}
