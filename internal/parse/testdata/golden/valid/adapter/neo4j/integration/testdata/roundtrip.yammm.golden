    {
      "name": "Typed",
      "name_span": {
        "s": 1108,
        "e": 1113
      },
      "doc": "Carries one property per Neo4j type expression the adapter can emit that\n   Document and Note do not already cover, so every expression is applied to a\n   real server and read back. A TYPE constraint is compared against the\n   server's propertyType by exact string, and the two only agree because the\n   adapter spells them the way Neo4j does — a claim that is worth checking\n   against a server rather than against the mapping that makes it.\n\n   Deliberately not extending Tracked: it stays out of the inheritance and\n   annotation round-trips so those keep asserting over the shapes they were\n   written for.",
      "props": [
        {
          "name": "typed_id",
          "constraint": {
            "kind": "UUID",
            "span": {
              "s": 1130,
              "e": 1134
            }
          },
          "primary": true,
          "span": {
