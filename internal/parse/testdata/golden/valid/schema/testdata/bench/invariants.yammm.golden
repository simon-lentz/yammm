      "invariants": [
        {
          "msg": "\"total is subtotal less discount\"",
          "expr": "(== (p \"total\") (- (p \"subtotal\") (p \"discount\")))",
          "expr_span": {
            "s": 503,
            "e": 531
          },
          "span": {
            "s": 467,
            "e": 531
          }
        },
        {
          "msg": "\"discount never exceeds subtotal\"",
          "expr": "(\u003c= (p \"discount\") (p \"subtotal\"))",
          "expr_span": {
            "s": 569,
            "e": 589
          },
          "span": {
            "s": 533,
            "e": 589
          }
        },
        {
          "msg": "\"quantity is positive\"",
          "expr": "(\u003e (p \"quantity\") 0)",
          "expr_span": {
            "s": 616,
            "e": 628
          },
          "span": {
            "s": 591,
            "e": 628
          }
        },
        {
          "msg": "\"reference is set once placed\"",
          "expr": "(|| (== (p \"status\") \"draft\") (!= (p \"reference\") nil))",
          "expr_span": {
            "s": 663,
            "e": 700
          },
          "span": {
            "s": 630,
            "e": 700
          }
        },
        {
          "msg": "\"reference is not blank\"",
          "expr": "(\u003e (Len (p \"reference\") (args ) (params ) nil) 0)",
          "expr_span": {
            "s": 729,
            "e": 749
          },
          "span": {
            "s": 702,
            "e": 749
          }
        },
        {
          "msg": "\"closed orders were placed\"",
          "expr": "(|| (!= (p \"status\") \"closed\") (!= (p \"placed_at\") nil))",
          "expr_span": {
            "s": 781,
            "e": 819
          },
          "span": {
            "s": 751,
            "e": 819
          }
        },
        {
          "msg": "\"reference looks like a code\"",
          "expr": "(=~ (p \"reference\") /^[A-Z]{3}-[0-9]+$/)",
          "expr_span": {
            "s": 853,
            "e": 885
          },
          "span": {
            "s": 821,
            "e": 885
          }
        },
        {
          "msg": "\"reference is not a draft marker\"",
          "expr": "(!~ (p \"reference\") /^DRAFT/)",
          "expr_span": {
            "s": 923,
            "e": 944
          },
          "span": {
            "s": 887,
            "e": 944
          }
        },
        {
          "msg": "\"shipped or closed carries a stamp\"",
          "expr": "(|| (\u0026\u0026 (!= (p \"status\") \"shipped\") (!= (p \"status\") \"closed\")) (!= (p \"placed_at\") nil))",
          "expr_span": {
            "s": 984,
            "e": 1047
          },
          "span": {
            "s": 946,
            "e": 1047
          }
        },
        {
          "msg": "\"totals stay in range\"",
          "expr": "(\u0026\u0026 (\u003e= (p \"total\") 0) (\u003c= (p \"total\") 1e+06))",
          "expr_span": {
            "s": 1074,
            "e": 1108
          },
          "span": {
            "s": 1049,
            "e": 1108
          }
        },
        {
          "msg": "\"status is known\"",
          "expr": "(|| (|| (|| (== (p \"status\") \"draft\") (== (p \"status\") \"placed\")) (== (p \"status\") \"shipped\")) (== (p \"status\") \"closed\"))",
          "expr_span": {
            "s": 1130,
            "e": 1214
          },
          "span": {
            "s": 1110,
            "e": 1214
          }
        },
        {
          "msg": "\"subtotal is not negative\"",
          "expr": "(\u003e= (p \"subtotal\") 0)",
          "expr_span": {
            "s": 1245,
