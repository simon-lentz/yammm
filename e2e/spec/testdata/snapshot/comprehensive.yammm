schema "SnapshotE2E"

type Email = Pattern["^[^@]+@[^@]+$"]

abstract type Auditable {
    created_at Timestamp required
}

part type Address {
    id String primary
    street String required
    city String required
    zip String[5, 5] required
}

part type Tag {
    label String[1, 50] required
}

type Department extends Auditable {
    id String primary
    name String required
    budget Float[0.0, _]
    active Boolean
    founded Date
}

type Employee extends Auditable {
    id UUID primary
    name String[1, 100] required
    email Email
    age Integer[0, 150]
    salary Float
    hired Timestamp
    status Enum["active", "inactive", "terminated"]
    skills List<String>
    scores List<Integer[0, 100]>
    embedding Vector[3]
    notes String
    --> WORKS_IN Department
    *-> HOME_ADDRESS (_:one) Address
    *-> TAGS (_:many) Tag
}
