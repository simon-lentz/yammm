// Associations and compositions across every multiplicity spelling, with
// backrefs and edge properties.
schema "bench_relations"

type Warehouse {
	id String primary
	name String required

	--> SUPPLIES (many) Depot
	*-> BAYS (many) Bay
}

type Depot {
	id String primary
	name String required
	region String[2, 2] required

	--> NEAREST (one) Warehouse
	--> PEERS (_:many) Depot
	--> CARRIES (many) Item {
		quantity Integer required
		reserved Integer
		added_at Timestamp
	}
	*-> DOCKS (_) Dock
}

part type Bay {
	id String primary
	position Integer required
}

part type Dock {
	id String primary
	width Float
}

type Item {
	sku String primary
	title String[1, 200] required
	weight Float[0.0, _]

	--> REPLACES (one:one) Item
	--> VARIANTS (one:many) Item
}
