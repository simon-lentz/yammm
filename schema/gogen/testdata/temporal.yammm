schema "temporal"

type Day   = Date
type Stamp = Timestamp

part type Reading {
	at Timestamp required
	on Date
}

part type Casing {
	serial String primary
}

type Sensor {
	id             String primary
	installed      Date required
	decommissioned Date
	created_at     Timestamp required
	seen_at        Timestamp
	day            Day
	stamp          Stamp
	days           List<Date>
	stamps         List<Timestamp>
	labels         List<String>
	*-> HAS_READING (many) Reading
	*-> IN_CASING (one) Casing
	--> FEEDS (one) Sensor {
		since Timestamp
	}
	--> NEIGHBOURS (many) Sensor
}
